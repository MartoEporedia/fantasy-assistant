# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fantasy_assistant
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Security
SECRET_KEY=your-secret-key-change-in-production
